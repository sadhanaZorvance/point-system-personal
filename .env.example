# StarPoints — Supabase Configuration
# Copy this file to .env and fill in your project credentials.
# Leave blank to run in localStorage-only mode (no Supabase required).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Personal/single-family mode: paste your user UUID from Supabase → Authentication → Users
# This bypasses login entirely — the app talks directly to your Supabase row.
VITE_SUPABASE_USER_ID=your-user-uuid-here
